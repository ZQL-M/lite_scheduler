<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tuba.schedulercore.mapper.TaskLogMapper">
    <select id="selectByTaskId" resultType="com.tuba.schedulercore.model.TaskLog">
        SELECT * FROM task_execution_log WHERE task_id = #{taskId} ORDER BY start_time DESC LIMIT #{limit} OFFSET #{offset}
    </select>
</mapper>